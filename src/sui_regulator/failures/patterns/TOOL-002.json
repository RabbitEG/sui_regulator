{
  "id": "TOOL-002",
  "name": "Repeated identical failed outcomes",
  "version": 2,
  "category": "tool_use",
  "signals": [
    "tool_call",
    "tool_result",
    "user_input"
  ],
  "detector": {
    "type": "failed_tools",
    "config": {
      "warn_after": 3,
      "act_after": 5,
      "argument_similarity": 0.98
    }
  },
  "severity": "high",
  "confidence_required": 0.95,
  "recovery": {
    "action": "quarantine",
    "preserve_task": true,
    "preserve_running_jobs": true,
    "max_attempts": 2,
    "retry_seconds": 1.0
  },
  "fixtures": {
    "positive": [
      "positive/failed-tools.jsonl"
    ],
    "negative": [
      "negative/failed-tools.jsonl"
    ]
  },
  "origin": "model_or_external_tool_unconfirmed",
  "observability": "structured signals and bounded text only; semantic root cause is unverified"
}
