{
  "id": "NET-003",
  "name": "Truncated/unfinished CLI stream",
  "version": 1,
  "category": "transport",
  "signals": [
    "stream_end"
  ],
  "detector": {
    "type": "truncated",
    "config": {
      "warn_after": 1,
      "act_after": 1
    }
  },
  "severity": "high",
  "confidence_required": 0.95,
  "recovery": {
    "action": "fresh_session",
    "preserve_task": true,
    "preserve_running_jobs": true,
    "max_attempts": 2,
    "retry_seconds": 1.0
  },
  "fixtures": {
    "positive": [
      "positive/truncated.jsonl"
    ],
    "negative": [
      "negative/truncated.jsonl"
    ]
  },
  "origin": "cli_or_transport_unconfirmed",
  "observability": "structured signals and bounded text only; semantic root cause is unverified"
}
