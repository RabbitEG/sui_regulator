# Optional systemd EnvironmentFile. Copy to:
# ~/.config/sui-regulator/controller.env, owned by the deployment UID, mode 0600.
# This is not a shell script: do not use `export`, $HOME, or command substitution.
# Leave these commented for Mock-only acceptance. Set only approved real values.
# ANTHROPIC_BASE_URL=https://YOUR_APPROVED_MESSAGES_ENDPOINT
# ANTHROPIC_API_KEY=YOUR_PRIVATE_KEY
# ANTHROPIC_AUTH_TOKEN=
# Model ID and the absolute Claude binary path belong in private config.toml.
